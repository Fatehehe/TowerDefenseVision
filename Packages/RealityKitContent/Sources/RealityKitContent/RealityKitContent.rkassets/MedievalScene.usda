            def RealityKitComponent "AudioLibrary"
            {
                uniform token info:id = "RealityKit.AudioLibrary"

                def RealityKitDict "resources"
                {
                    string[] keys = ["Voice-of-Earth-chosic.com_.mp3"]
                    rel values = </Root/Voice_of_Earth_chosic_com__mp3>
                }
            }

            def RealityKitComponent "RCP_BehaviorsContainer"
            {
                rel behaviors = </Root/Environment/Floor2/OnAddedToScene>
                uniform token info:id = "RCP.BehaviorsContainer"
            }

            def Preliminary_Behavior "OnAddedToScene"
            {
                rel actions = </Root/Environment/Floor2/OnAddedToScene/Action>
                uniform bool exclusive
                rel triggers = </Root/Environment/Floor2/OnAddedToScene/Trigger>

                def Preliminary_Trigger "Trigger"
                {
                    rel affectedObjects = </Root/Environment/Floor2>
                    token info:id = "SceneTransition"
                }

                def Preliminary_Action "Action"
                {
                    rel affectedObjects = </Root>
                    rel animationLibraryKey = </Root/BGMSound>
                    rel animationLibraryKeyOverrideKey = </Root/Environment/Floor2/OnAddedToScene/Trigger>
                    token info:id = "PlayTimeline"
                    int loops = 0
                    int performCount = 1
                    token type = "serial"
                }
            }
        }

        def "Watchtower" (
            active = true
            customData = {
