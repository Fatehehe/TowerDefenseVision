#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.100.6)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Floor", "Houses", "Tower", "Environment"]
    def Scope "Environment" (
        active = true
    )
    {
        reorder nameChildren = ["Floor", "Houses", "Tower"]
        def "Floor" (
            active = true
            references = @TechArts/Meshs/Floor.usdc@
        )
        {
            quatf xformOp:orient = (6.1232336e-17, 4.32978e-17, 0.70710677, 0.7071067)
            float3 xformOp:scale = (0.99999994, 0.99999994, 0.99999994)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "_materials"
            {
                over "Ground" (
                    references = @TechArts/Shader/PBR_Material.usda@</Root/UnlitMaterial>
                )
                {
                    asset inputs:BakedTexture = @TechArts/Textures/EnviTextures/Env_Grass_Diffuse.png@ (
                        customData = {
                            dictionary realitykit = {
                                float2 positionInSubgraph = (-968.70966, 128.24625)
                                int stackingOrderInSubgraph = 13
                            }
                        }
                    )
                    token outputs:mtlx:surface
                    token outputs:realitykit:vertex
                    token outputs:surface.connect = </Root/_materials/Ground/Principled_BSDF.outputs:surface>
                    float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (-180.04507, 209.94101)
                    int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 13

                    over "Image2D"
                    {
                        float2 ui:nodegraph:node:pos = (-714.97546, 211.39203)
                        int ui:nodegraph:node:stackingOrder = 13
                    }

                    over "UnlitSurface"
                    {
                        float2 ui:nodegraph:node:pos = (-479.40335, 296.92105)
                        int ui:nodegraph:node:stackingOrder = 13
                    }
                }
            }

            over "Ground_001" (
                active = false
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Root/Environment/Floor/_materials/Ground> (
                    bindMaterialAs = "weakerThanDescendants"
                )

                over "Plane_003"
                {
                }
            }

            over "Ground"
            {
                over "Plane_005"
                {
                }
            }
        }

        def "Houses" (
            active = true
            references = @TechArts/Meshs/Houses.usdc@
        )
        {
            quatf xformOp:orient = (6.1232336e-17, 4.32978e-17, 0.70710677, 0.7071067)
            float3 xformOp:scale = (0.99999994, 0.99999994, 0.99999994)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "_materials"
            {
                over "MAIN" (
                    references = @TechArts/Shader/PBR_Material.usda@</Root/UnlitMaterial>
                )
                {
                    asset inputs:BakedTexture = @TechArts/Textures/EnviTextures/WALL2.png@
                    token outputs:mtlx:surface
                    token outputs:realitykit:vertex
                }

                over "ROOFM" (
                    references = @TechArts/Shader/PBR_Material.usda@</Root/DefaultMaterial>
                )
                {
                    asset inputs:BaseTexture = @TechArts/Textures/EnviTextures/ROOF1.png@
                    asset inputs:NormalTexture = @TechArts/Textures/EnviTextures/ROOF1N.png@
                    asset inputs:RoughnessTexture (
                        customData = {
                            dictionary realitykit = {
                                float2 positionInSubgraph = (-1005.64856, 111.829956)
                                int stackingOrderInSubgraph = 77
                            }
                        }
                    )
                    token outputs:mtlx:surface
                    token outputs:realitykit:vertex
                    float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (487.79193, 81.4069)
                    int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 75

                    over "PreviewSurface"
                    {
                        float inputs:roughness = 1
                        delete float inputs:roughness.connect = </Root/Houses/_materials/ROOFM/Image_1.outputs:out>
                        int ui:nodegraph:node:stackingOrder = 84
                    }

                    over "Image_1"
                    {
                        float2 ui:nodegraph:node:pos = (-686.8907, 140.91663)
                        int ui:nodegraph:node:stackingOrder = 77
                        string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["inputs:texcoord"]
                    }
                }

                over "Window"
                {
                    token outputs:mtlx:surface
                    token outputs:realitykit:vertex
                    float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (0, 110.5)
                }
            }
        }

        def "Tower" (
            active = true
            references = @TechArts/Meshs/Tower.usdc@
        )
        {
            quatf xformOp:orient = (6.1232336e-17, 4.32978e-17, 0.70710677, 0.7071067)
            float3 xformOp:scale = (0.99999994, 0.99999994, 0.99999994)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "_materials"
            {
                over "MAIN"
                {
                    token outputs:mtlx:surface
                    token outputs:realitykit:vertex
                }
            }

            over "Tower" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = None (
                    bindMaterialAs = "weakerThanDescendants"
                )

                over "Plane_453"
                {
                    over "MAIN" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Root/Environment/Houses/_materials/MAIN> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }

                    over "ROOFM" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Root/Environment/Houses/_materials/ROOFM> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }
            }
        }
    }

    def "Floor2" (
        active = true
        prepend references = @TechArts/Meshs/Floor2.usdc@
    )
    {
        quatf xformOp:orient = (4.3297803e-17, 4.3297803e-17, 0.70710677, 0.70710677)
        float3 xformOp:scale = (1.2, 1.2, 1.2)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "_materials"
        {
            over "Ground" (
                references = @TechArts/Shader/PBR_Material.usda@</Root/UnlitMaterial>
            )
            {
                asset inputs:BakedTexture = @TechArts/Textures/EnviTextures/Env_Grass_Diffuse.png@
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }
        }
    }

    def "Watchtower" (
        active = true
        customData = {
            float3 rotationEulerHint = (0, -1.1519173, 0)
        }
        prepend references = @Watchtower.usda@
    )
    {
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        quatf xformOp:orient = (0.83867055, 0, -0.54463905, 0)
        float3 xformOp:scale = (1.5, 1.5, 1.5)
        float3 xformOp:translate = (-10.494952, 0, 6.07513)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

