            }
            references = @Watchtower.usda@
        )
        {
            float2 ui:nodegraph:node:pos = (20, 20)
            int ui:nodegraph:node:stackingOrder = 1
            quatf xformOp:orient = (0.83867055, 0, -0.54463905, 0)
            float3 xformOp:scale = (1.5, 1.5, 1.5)
            float3 xformOp:translate = (-11.046367, 0, 5.5332937)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def RealityKitAudioFile "Voice_of_Earth_chosic_com__mp3"
    {
        uniform asset file = @TechArts/Audio/Voice-of-Earth-chosic.com_.mp3@
        uniform bool shouldLoop = 1
    }

    def RealityKitTimeline "BGMSound"
    {
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Play_Audio"
            {
                string actionKind = "audio"
                string audioResourceName = "Voice-of-Earth-chosic.com_.mp3"
                bool controlPlayback = 1
                double duration = 139.389375
                double gain = 0
                uniform token info:id = "32384CE3-626F-4E57-A83E-0B1CCDA70EA2"
                double loopCount = 0
                double startTime = 0
                rel target = </Root/Environment/Floor2>

                def RealityKitStruct "handoffType"
                {
                }
            }
        }
    }
}

